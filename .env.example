# Copy to .env and fill in. Nothing here is required to run ingestion,
# chunking, or the local (BM25 / sentence-transformers / FAISS) retrieval
# harness -- those work fully offline. Only generation, LLM-as-judge, and
# hosted vector search need keys below.

# --- Generation (Google AI Studio; free tier, no card required) ---
GOOGLE_API_KEY=
# Free tier caps gemini-3.1-flash-lite at 15 req/min; raise this on a paid key
# (src/taglish_rag/ratelimit.py). Unset = 15.
GEMINI_MAX_RPM=

# --- Vector store (optional; defaults to local FAISS if unset) ---
SUPABASE_URL=
SUPABASE_KEY=
VECTOR_STORE_BACKEND=faiss

# --- Deployment / publishing (only needed for Day 6-7 steps) ---
HF_TOKEN=
HF_SPACE_REPO_ID=
HF_DATASET_REPO_ID=
